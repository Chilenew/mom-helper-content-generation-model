
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/storyboard.schema.json",
  "title": "My Strong Mother Film Storyboard",
  "description": "Schema for the AI-generated short film ጠንካራዋ እናቴ.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "english_title",
    "language",
    "target_duration",
    "genre",
    "style",
    "aspect_ratios",
    "target_audience",
    "purpose",
    "central_message",
    "visual_consistency",
    "shots",
    "end_card"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "english_title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "const": "Amharic"
    },
    "target_duration": {
      "type": "integer",
      "minimum": 60,
      "maximum": 90
    },
    "genre": {
      "type": "string"
    },
    "style": {
      "type": "string"
    },
    "aspect_ratios": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["9:16", "16:9"]
      },
      "minItems": 2,
      "uniqueItems": true
    },
    "target_audience": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "central_message": {
      "type": "string"
    },
    "visual_consistency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "character",
        "environment",
        "lighting",
        "disclosure"
      ],
      "properties": {
        "character": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "lighting": {
          "type": "string"
        },
        "disclosure": {
          "type": "string"
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/shot"
      }
    },
    "end_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "subtitle",
        "disclosure",
        "duration_seconds"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "disclosure": {
          "type": "string"
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    }
  },
  "$defs": {
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "duration",
        "narration",
        "image_prompt",
        "motion_prompt",
        "music_cue",
        "shot_reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^shot_[0-9]{2}$"
        },
        "duration": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 90
        },
        "narration": {
          "type": "string",
          "minLength": 1
        },
        "image_prompt": {
          "type": "string",
          "minLength": 1
        },
        "motion_prompt": {
          "type": "string",
          "minLength": 1
        },
        "music_cue": {
          "type": "string",
          "minLength": 1
        },
        "shot_reason": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
