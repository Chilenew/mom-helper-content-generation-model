{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/heritage-short/pipeline.schema.json",
  "title": "Merged pipeline storyboard",
  "description": "What every stage reads: storyboard/storyboard.json (the story, validated by storyboard.schema.json) merged with storyboard/pipeline_config.json (models, seeds, characters, cues, export). src/validate.py builds the merge and validates it against this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "title",
    "logline",
    "audience",
    "intent",
    "language",
    "style_block",
    "models",
    "characters",
    "narration_settings",
    "music",
    "shots",
    "end_card",
    "export"
  ],
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Bump when the storyboard changes after a user test, so DESIGN.md can point at versions."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "english_title": {
      "type": "string"
    },
    "genre": {
      "type": "string"
    },
    "target_duration": {
      "type": "number"
    },
    "logline": {
      "type": "string",
      "minLength": 10
    },
    "audience": {
      "type": "string",
      "minLength": 10
    },
    "intent": {
      "type": "string",
      "minLength": 10,
      "description": "What the audience should feel or understand when the film ends."
    },
    "language": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "narration",
        "subtitles"
      ],
      "properties": {
        "narration": {
          "$ref": "#/$defs/langCode"
        },
        "subtitles": {
          "$ref": "#/$defs/langCode"
        }
      }
    },
    "style_block": {
      "type": "string",
      "minLength": 10,
      "description": "Fixed look description appended to every keyframe prompt to prevent drift."
    },
    "negative_prompt": {
      "type": "string",
      "description": "Global negative prompt for models that accept one."
    },
    "visual_consistency": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "keyframes",
        "shots",
        "music",
        "narration"
      ],
      "properties": {
        "keyframes": {
          "$ref": "#/$defs/modelRef"
        },
        "shots": {
          "$ref": "#/$defs/modelRef"
        },
        "music": {
          "$ref": "#/$defs/modelRef"
        },
        "narration": {
          "$ref": "#/$defs/modelRef"
        },
        "script": {
          "$ref": "#/$defs/modelRef"
        }
      }
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "reference_prompt",
          "seed",
          "show_face",
          "real_person"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "description": "Fixed description pasted into every prompt this character appears in."
          },
          "reference_prompt": {
            "type": "string",
            "minLength": 10
          },
          "reference_image": {
            "type": "string",
            "description": "Path to the approved golden reference, filled in after the reference sheet is chosen."
          },
          "seed": {
            "$ref": "#/$defs/seed"
          },
          "show_face": {
            "type": "boolean",
            "description": "False means the character is only shown from behind, in profile, or as hands."
          },
          "real_person": {
            "type": "boolean",
            "description": "True requires a consent record in ETHICS.md before generation."
          },
          "consent_ref": {
            "type": "string",
            "description": "Anchor or id of the consent record in ETHICS.md."
          }
        },
        "if": {
          "properties": {
            "real_person": {
              "const": true
            }
          }
        },
        "then": {
          "required": [
            "consent_ref"
          ]
        }
      }
    },
    "narration_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "voice",
        "style_instruction"
      ],
      "properties": {
        "voice": {
          "type": "string"
        },
        "style_instruction": {
          "type": "string"
        },
        "words_per_second_estimate": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "english_voice": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "voice"
          ],
          "properties": {
            "voice": {
              "type": "string"
            },
            "rate": {
              "type": "string"
            },
            "pitch": {
              "type": "string"
            }
          },
          "description": "Voice for the English voice-over versions (reads shots[].narration.subtitle_en)."
        }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidates",
        "cues"
      ],
      "properties": {
        "candidates": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10,
          "description": "How many score candidates to generate before choosing one."
        },
        "chosen_candidate": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "Index of the chosen candidate; null until chosen and justified in EXPERIMENTS.md."
        },
        "cues": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "start_shot",
              "end_shot",
              "caption",
              "bpm",
              "key",
              "instrumental",
              "purpose",
              "seed"
            ],
            "properties": {
              "id": {
                "$ref": "#/$defs/id"
              },
              "start_shot": {
                "$ref": "#/$defs/id"
              },
              "end_shot": {
                "$ref": "#/$defs/id"
              },
              "caption": {
                "type": "string",
                "minLength": 10
              },
              "bpm": {
                "type": "integer",
                "minimum": 40,
                "maximum": 200
              },
              "key": {
                "type": "string"
              },
              "instrumental": {
                "type": "boolean"
              },
              "purpose": {
                "type": "string",
                "minLength": 5
              },
              "seed": {
                "$ref": "#/$defs/seed"
              }
            }
          }
        },
        "ducking": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "threshold": {
              "type": "number"
            },
            "ratio": {
              "type": "number"
            },
            "attack_ms": {
              "type": "number"
            },
            "release_ms": {
              "type": "number"
            }
          }
        },
        "chosen_reason": {
          "type": "string",
          "description": "Why this candidate was chosen; mirror it in EXPERIMENTS.md."
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/shot"
      }
    },
    "end_card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "duration_s"
      ],
      "properties": {
        "text": {
          "type": "string",
          "pattern": "(?i)\\bAI\\b"
        },
        "duration_s": {
          "type": "number",
          "minimum": 2,
          "maximum": 5
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aspect_ratios",
        "fps",
        "loudness_lufs",
        "true_peak_db",
        "min_total_s",
        "max_total_s"
      ],
      "properties": {
        "aspect_ratios": {
          "type": "array",
          "items": {
            "enum": [
              "9:16",
              "16:9"
            ]
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "fps": {
          "type": "integer",
          "enum": [
            24,
            25,
            30
          ]
        },
        "draft_resolution": {
          "enum": [
            "480p",
            "720p"
          ]
        },
        "final_resolution": {
          "enum": [
            "480p",
            "720p",
            "1080p"
          ]
        },
        "loudness_lufs": {
          "type": "number",
          "minimum": -24,
          "maximum": -9
        },
        "true_peak_db": {
          "type": "number",
          "maximum": 0
        },
        "min_total_s": {
          "type": "number"
        },
        "max_total_s": {
          "type": "number"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "langCode": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$"
    },
    "modelRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "provider"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "provider": {
          "type": "string"
        },
        "params": {
          "type": "object"
        }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "duration_s",
        "shot_size",
        "reason",
        "characters",
        "keyframe",
        "motion",
        "narration"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "duration_s": {
          "type": "number",
          "minimum": 3,
          "maximum": 12
        },
        "shot_size": {
          "enum": [
            "extreme_wide",
            "wide",
            "medium",
            "close_up",
            "extreme_close_up",
            "over_the_shoulder",
            "pov"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 10,
          "description": "Why this shot exists, in one sentence."
        },
        "characters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "keyframe": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "prompt",
            "seed"
          ],
          "properties": {
            "prompt": {
              "type": "string",
              "minLength": 10
            },
            "seed": {
              "$ref": "#/$defs/seed"
            },
            "negative_prompt": {
              "type": "string"
            }
          }
        },
        "motion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "prompt"
          ],
          "properties": {
            "mode": {
              "enum": [
                "i2v",
                "ken_burns",
                "still"
              ],
              "description": "i2v = Wan image-to-video; ken_burns = FFmpeg pan/zoom fallback; still = hold."
            },
            "prompt": {
              "type": "string"
            },
            "seed": {
              "$ref": "#/$defs/seed"
            },
            "ken_burns": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "direction": {
                  "enum": [
                    "zoom_in",
                    "zoom_out",
                    "pan_left",
                    "pan_right",
                    "pan_up",
                    "pan_down"
                  ]
                },
                "amount": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 0.5
                }
              }
            }
          },
          "if": {
            "properties": {
              "mode": {
                "const": "i2v"
              }
            }
          },
          "then": {
            "required": [
              "seed"
            ]
          }
        },
        "narration": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "subtitle_en"
          ],
          "properties": {
            "text": {
              "type": "string",
              "description": "Narration in the narration language; may be empty for a silent shot."
            },
            "subtitle_en": {
              "type": "string"
            },
            "pronunciation_notes": {
              "type": "string"
            }
          }
        },
        "music_cue": {
          "$ref": "#/$defs/id"
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}
