# Copy to .env and fill in. .env is in .gitignore: never commit real keys.

# Google AI Studio -> Get API key (free tier works from Ethiopia)
GEMINI_API_KEY=

# Cloudflare dashboard -> AI -> Workers AI: your account id, and an API token with "Workers AI" permission
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Optional overrides when a model name in storyboard.json has changed (log the change in FAILURES.md)
# TEXT_MODEL=gemini-3.8-flash
# TTS_MODEL=gemini-3.8-flash-tts
# KEYFRAME_MODEL=@cf/black-forest-labs/flux-2-klein-4b

# Microsoft Azure AI Speech (Amharic narration): portal.azure.com -> create a 'Speech service' (Free F0)
# -> Keys and Endpoint: copy KEY 1 and the Location/Region (e.g. eastus, westeurope)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
